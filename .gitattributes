# Enforce LF line endings for all text files
* text=auto eol=lf

# Binary assets (no line-ending normalization)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Next.js build output
.next/** binary

# Archives
*.zip binary
*.gz binary
*.tar binary
